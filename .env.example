# Fill these values in EdgeOne Makers server-side environment settings.
# Agent Plan requires its own API Key and a model available in that plan.
AI_GATEWAY_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AI_GATEWAY_MODEL=doubao-seed-2-1-turbo-260628
AI_GATEWAY_API_KEY=YOUR_API_KEY
# Optional: use a separate Agent Plan key for Doubao Search. If omitted,
# the search endpoint reuses AI_GATEWAY_API_KEY.
# SEARCH_API_KEY=YOUR_AGENT_PLAN_API_KEY
